<metro:MetroWindow  x:Class="AutoLiquid_Bluescape_Fermentation_Plus.Window.WindowProcedure"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:metro="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:userControls="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
                    mc:Ignorable="d"
                    d:DesignWidth="1750"
                    d:DesignHeight="1500"
                    Title="{StaticResource Procedure}"  WindowStartupLocation="CenterScreen" WindowState="Maximized" GlowBrush="{DynamicResource 	MahApps.Brushes.Accent}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,5,0,0">
            <Label HorizontalContentAlignment="Center" Content="{StaticResource Procedure}" FontSize="{StaticResource DefaultFontSizeSmall}"/>
            <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource DefaultFontSizeSmall}"/>
            <ComboBox x:Name="ComboBoxProcedures" Width="250" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center"/>
            <Button x:Name="BtnProcedureNew" Content="{StaticResource New}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="50" Height="30" FontSize="14" Margin="10,0,0,0"/>
            <Button x:Name="BtnProcedureDel" Content="{StaticResource Delete}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="50" Height="30" FontSize="14" Margin="10,0,0,0"/>

            <Label HorizontalContentAlignment="Center" Content="{StaticResource SteelNeedleChoice}" FontSize="{StaticResource DefaultFontSizeSmall}" Margin="30,0,0,0"/>
            <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource DefaultFontSizeSmall}"/>
            <ComboBox x:Name="ComboBoxSteelNeedleChoice" Width="{StaticResource SettingValueWidth}" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center" SelectedIndex="0">
                <ComboBox.Items>
                    <ComboBoxItem>14#</ComboBoxItem>
                    <ComboBoxItem>15#</ComboBoxItem>
                    <ComboBoxItem>16#</ComboBoxItem>
                    <ComboBoxItem>17#</ComboBoxItem>
                    <ComboBoxItem>18#</ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>

            <Label HorizontalContentAlignment="Center" Content="{StaticResource RunTimeExpect}" FontSize="{StaticResource DefaultFontSizeSmall}" Margin="30,0,0,0"/>
            <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource DefaultFontSizeSmall}"/>
            <TextBox x:Name="TextBoxRunTimeExpect" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
            <Label Content="{StaticResource UnitMin}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>

        </StackPanel>
        <userControls:ControlDataGridProcedure x:Name="ControlDataGridProcedure" Grid.Row="2" Margin="0,5,0,0"/>
    </Grid>
</metro:MetroWindow>
