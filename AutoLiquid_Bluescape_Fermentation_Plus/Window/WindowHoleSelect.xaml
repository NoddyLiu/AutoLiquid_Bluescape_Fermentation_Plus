<metro:MetroWindow x:Class="AutoLiquid_Bluescape_Fermentation_Plus.Window.WindowHoleSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:metro="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:ctl="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
        Title="{StaticResource SelectHoles}" 
        WindowState="Normal"  
        WindowStartupLocation="CenterScreen" 
        Height="800" Width="600" ShowMinButton="False" ShowMaxRestoreButton="False" ShowCloseButton="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <CheckBox x:Name="cbSelectAll" Content="{DynamicResource SelectAll}" Margin="20,0,0,0"></CheckBox>
        </StackPanel>

        <Grid Grid.Row="1"  x:Name="Template" x:FieldModifier="public" Background="AliceBlue">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" 
                            x:Name="StackPanelTipsBox" 
                            Margin="0,0,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="0"  x:Name="TextBlockTemplateName" 
                           Text="{StaticResource TemplateFermentation1}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"
                           FontSize="16"/>

        </Grid>

        <StackPanel x:Name="StackPanelBtn"  Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">
            <Label x:Name="LabelPromptLogicIncorrect" Content="{StaticResource Prompt_Hole_Select_Logic_Incorrect}" Foreground="Red" Visibility="Collapsed"/>
            <Button x:Name="BtnSave" Content="{StaticResource Save}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="90" Height="40" FontSize="20" Margin="10,0,0,0"/>
            <Button x:Name="BtnCancel"  Content="{StaticResource Cancel}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="90" Height="40" FontSize="20" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</metro:MetroWindow>
