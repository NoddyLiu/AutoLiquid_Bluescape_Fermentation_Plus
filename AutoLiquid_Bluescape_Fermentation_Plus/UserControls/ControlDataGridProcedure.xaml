<UserControl x:Class="AutoLiquid_Bluescape_Fermentation_Plus.UserControls.ControlDataGridProcedure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utils="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.Utils"
             xmlns:userControls="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
             xmlns:mvvm="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.Mvvm"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1500">
    <Grid>
        <userControls:DataGridWithRowNum x:Name="DataGridDetail" ShowRowNumbers="True" ItemsSource="{Binding ProcedureSteps, NotifyOnTargetUpdated=True}" Style="{StaticResource DataGridStyle}" Background="Transparent" AutoGenerateColumns="false"  HorizontalAlignment="Left" FrozenColumnCount="0" HeadersVisibility="All" CanUserAddRows="false" Margin="0,1,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanUserResizeRows="False" EnableRowVirtualization="False">
            <DataGrid.Resources>
                <!--源盘合并单元格-->
                <DataTemplate x:Key="StyleSourceDataGridHeader">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.40*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.20*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Content="{StaticResource TemplateSource}" HorizontalContentAlignment="Stretch"/>
                        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="{StaticResource Type}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="1"/>
                        <Label Grid.Row="2" Grid.Column="2" Content="{StaticResource Template}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="3"/>
                        <Label Grid.Row="2" Grid.Column="4" Content="{StaticResource Consumable}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="5"/>
                        <Label Grid.Row="2" Grid.Column="6" Content="{StaticResource Hole}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="StyleSourceDataGridCell">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.40*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.20*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"  SelectedIndex="{Binding SourceTemplateTypeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding SourceTypeEditable}" />
                                </Style>
                            </ComboBox.Style>
                            <ComboBoxItem Content="{StaticResource TemplateFermentation}"/>
                            <ComboBoxItem Content="{StaticResource TemplateSample}"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding SourceTemplateList}" SelectedItem="{Binding SourceTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding SourceTemplateIndexEditable}" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding SourceConsumableList}"  SelectedItem="{Binding SourceConsumable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding SourceConsumableEditable}" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Label Grid.Column="6" Content="{Binding SourceHoleRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{StaticResource Prompt_Double_Click_2_Modify}" MouseDoubleClick="SourceHolesOnMouseDoubleClick">
                            <Label.Style>
                                <Style BasedOn="{StaticResource LabelStyle}" TargetType="Label">
                                    <Setter Property="IsEnabled" Value="{Binding SourceHoleRangeEditable}" />
                                </Style>
                            </Label.Style>
                        </Label>
                    </Grid>
                </DataTemplate>

                <!--靶盘合并单元格-->
                <DataTemplate x:Key="StyleTargetDataGridHeader">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.40*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.25*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Content="{StaticResource TemplateTarget}" HorizontalContentAlignment="Stretch"/>
                        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="{StaticResource Type}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="1"/>
                        <Label Grid.Row="2" Grid.Column="2" Content="{StaticResource Template}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="3"/>
                        <Label Grid.Row="2" Grid.Column="4" Content="{StaticResource Consumable}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="5"/>
                        <Label Grid.Row="2" Grid.Column="6" Content="{StaticResource Hole}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="7"/>
                        <Label Grid.Row="2" Grid.Column="8" Content="{StaticResource Volume}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="StyleTargetDataGridCell">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.40*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.25*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"  SelectedIndex="{Binding TargetTemplateTypeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding TargetTemplateEditable}" />
                                </Style>
                            </ComboBox.Style>
                            <ComboBoxItem Content="{StaticResource TemplateFermentation}"/>
                            <ComboBoxItem Content="{StaticResource TemplateSample}"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding TargetTemplateList}"  SelectedItem="{Binding TargetTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding TargetTemplateEditable}" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding TargetConsumableList}"  SelectedItem="{Binding TargetConsumable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding TargetTemplateEditable}" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Label Grid.Column="6" Content="{Binding TargetHoleRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{StaticResource Prompt_Double_Click_2_Modify}" MouseDoubleClick="TargetHolesOnMouseDoubleClick">
                            <Label.Style>
                                <Style BasedOn="{StaticResource LabelStyle}" TargetType="Label">
                                    <Setter Property="IsEnabled" Value="{Binding TargetHoleRangeEditable}" />
                                </Style>
                            </Label.Style>
                        </Label>
                        <TextBox Grid.Column="8" Text="{Binding VolumeEach, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource TextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="IsEnabled" Value="{Binding VolumeEachEditable}" />
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </DataTemplate>

                <!--清洗区合并单元格-->
                <DataTemplate x:Key="StyleCleaningDataGridHeader">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.75*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="{StaticResource TemplateCleaning}" HorizontalContentAlignment="Stretch"/>
                        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="{StaticResource IsNeedCleaning}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <GridSplitter Grid.Row="2" Grid.Column="1"/>
                        <Label Grid.Row="2" Grid.Column="2" Content="{StaticResource Position}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="StyleCleaningDataGridCell">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.24*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.24*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.24*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsNeedCleaning, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <CheckBox.Style>
                                <Style BasedOn="{StaticResource CheckBoxStyle}" TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CleaningEditable}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding CleaningPosList}" SelectedIndex="{Binding CleaningPosIndexArray[0], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding CleaningEditable}" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding CleaningPosList}" SelectedIndex="{Binding CleaningPosIndexArray[1], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding CleaningEditable}" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ComboBox Grid.Column="6" ItemsSource="{Binding CleaningPosList}" SelectedIndex="{Binding CleaningPosIndexArray[2], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="{Binding CleaningEditable}" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                </DataTemplate>

                <!--循环合并单元格-->
                <DataTemplate x:Key="StyleLoopDataGridHeader">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.65*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.35*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="{StaticResource Loop}" HorizontalContentAlignment="Stretch"/>
                        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="{StaticResource StartStop}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="{StaticResource Prompt_StartStop}"/>
                        <GridSplitter Grid.Row="2" Grid.Column="1"/>
                        <Label Grid.Row="2" Grid.Column="2" Content="{StaticResource Times}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="StyleLoopDataGridCell">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.65*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="0.35*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LoopStepRange[0], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{StaticResource Prompt_StartStop}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TextBoxStyle}" TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="{Binding LoopEditable}" />
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Grid.Column="1" Text="~">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TextBoxStyle}" TargetType="TextBox">
                                        <Setter Property="IsReadOnly" Value="True" />
                                        <Setter Property="IsEnabled" Value="{Binding LoopEditable}" />
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Grid.Column="2" Text="{Binding LoopStepRange[1], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{StaticResource Prompt_StartStop}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TextBoxStyle}" TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="{Binding LoopEditable}" />
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                        <TextBox Grid.Column="2" Text="{Binding LoopTimes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource TextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="IsEnabled" Value="{Binding LoopEditable}" />
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </DataTemplate>
            </DataGrid.Resources>

            <!--行号-->
            <userControls:DataGridWithRowNum.RowHeaderTemplate>
                <DataTemplate>
                    <Label HorizontalAlignment="Center" HorizontalContentAlignment="Center" Content="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" FontSize="{StaticResource DefaultFontSizeSmall}" Width="{StaticResource DataGridRowHeaderNumWidth}"/>
                </DataTemplate>
            </userControls:DataGridWithRowNum.RowHeaderTemplate>
            <DataGrid.Columns>
                <!--步骤名称-->
                <DataGridTextColumn Header="{StaticResource StepName}" Width="0.15*"  Binding="{Binding StepName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CanUserReorder="False"  CanUserResize="False" CanUserSort="False" />
                <!--步骤类型-->
                <DataGridTemplateColumn Header="{StaticResource StepType}" Width="0.20*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="mvvm:ModelColumnStep">
                            <ComboBox ItemsSource="{Binding StepTypeList}"  SelectedItem="{Binding StepType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--源盘-->
                <DataGridTemplateColumn HeaderTemplate="{StaticResource StyleSourceDataGridHeader}" CellTemplate="{StaticResource StyleSourceDataGridCell}"  Width="0.65*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False"/>
                <!--靶盘-->
                <DataGridTemplateColumn HeaderTemplate="{StaticResource StyleTargetDataGridHeader}" CellTemplate="{StaticResource StyleTargetDataGridCell}"  Width="0.78*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False"/>
                <!--清洗区-->
                <DataGridTemplateColumn HeaderTemplate="{StaticResource StyleCleaningDataGridHeader}" CellTemplate="{StaticResource StyleCleaningDataGridCell}"  Width="0.45*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False"/>
                <!--循环-->
                <DataGridTemplateColumn HeaderTemplate="{StaticResource StyleLoopDataGridHeader}" CellTemplate="{StaticResource StyleLoopDataGridCell}"  Width="0.30*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False"/>
                <!--温度-->
                <userControls:DataGridNumericColumn Header="{StaticResource Temp}" Width="0.25*"  Binding="{Binding Temp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CanUserReorder="False"  CanUserResize="False" CanUserSort="False" Visibility="Collapsed">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource DataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="IsEnabled" Value="{Binding TempEditable}" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </userControls:DataGridNumericColumn>
                <!--时间-->
                <userControls:DataGridNumericColumn Header="{StaticResource Time2Line}" Width="0.10*"  Binding="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CanUserReorder="False"  CanUserResize="False" CanUserSort="False">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource DataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="IsEnabled" Value="{Binding TimeEditable}" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </userControls:DataGridNumericColumn>
                <!--等待是否阻塞-->
                <DataGridCheckBoxColumn Header="{StaticResource Block}" Width="0.09*" Binding="{Binding Block, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CanUserReorder="False"  CanUserResize="False" CanUserSort="False">
                    <DataGridCheckBoxColumn.HeaderStyle>
                        <Style BasedOn="{StaticResource DataGridHeaderStyle}" TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="{StaticResource Prompt_Wait_Step_Block}"/>
                        </Style>
                    </DataGridCheckBoxColumn.HeaderStyle>
                    <DataGridCheckBoxColumn.CellStyle>
                        <Style BasedOn="{StaticResource DataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="IsEnabled" Value="{Binding BlockEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridCheckBoxColumn.CellStyle>
                </DataGridCheckBoxColumn>
                <!--等待序号-->
                <DataGridTemplateColumn Header="{StaticResource WaitForOrder2Line}" Width="0.11*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="mvvm:ModelColumnStep">
                            <ComboBox ItemsSource="{Binding WaitForOrderList}"  SelectedItem="{Binding WaitForOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                                <ComboBox.Style>
                                    <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                        <Setter Property="IsEnabled" Value="{Binding WaitForOrderEditable}" />
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--速度等级-->
                <DataGridTemplateColumn Header="{StaticResource SpeedLevel}" Width="0.25*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False"  Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="mvvm:ModelColumnStep">
                            <ComboBox ItemsSource="{Binding SpeedLevelList}" SelectedItem="{Binding SpeedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent" FontSize="{StaticResource DefaultFontSizeSmall}" HorizontalContentAlignment="Center">
                                <ComboBox.Style>
                                    <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                        <Setter Property="IsEnabled" Value="{Binding SpeedLevelEditable}" />
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--操作-->
                <DataGridTemplateColumn Header="{StaticResource Operate}" Width="0.35*" CanUserReorder="False"  CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnNew" Content="{StaticResource New}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="40" Height="30" FontSize="14" Click="BtnNewOnClick"/>
                                <Button x:Name="BtnDel" Content="{StaticResource Delete}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="40" Height="30" FontSize="14" Margin="3,0,0,0" Click="BtnDelOnClick"/>
                                <Button x:Name="BtnUp" Content="{StaticResource Up}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="40" Height="30" FontSize="14" Margin="3,0,0,0" Click="BtnUpOnClick"/>
                                <Button x:Name="BtnDown" Content="{StaticResource Down}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="40" Height="30" FontSize="14" Margin="3,0,0,0" Click="BtnDownOnClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </userControls:DataGridWithRowNum>
    </Grid>
</UserControl>
