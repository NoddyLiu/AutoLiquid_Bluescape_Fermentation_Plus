<UserControl x:Class="AutoLiquid_Bluescape_Fermentation_Plus.UserControls.ControlSettingShake"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             Background="White">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,3">
            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <Label HorizontalContentAlignment="Center" Content="{StaticResource ShakeSpeedMaxCmd}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <TextBox x:Name="TextBoxShakeSpeedMaxCmd" Width="{StaticResource SettingSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}" />
            </StackPanel>

            <Button x:Name="BtnShakeSpeedMaxStart" Content="{StaticResource Run}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="60" Height="30" FontSize="{StaticResource SettingBtnFontSize}" Margin="0,0,0,0"/>
            <Button x:Name="BtnShakeSpeedMaxStop" Content="{StaticResource Stop}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="60" Height="30" FontSize="{StaticResource SettingBtnFontSize}" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
