<UserControl x:Class="AutoLiquid_Bluescape_Fermentation_Plus.UserControls.ControlSettingSteelNeedle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             Background="White">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Vertical">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <!--标题-->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2">
                    <Label  Width="{StaticResource BtnTrimmingWidth}"/>
                    <Label  Width="{StaticResource SettingHoleValueWidth}" HorizontalContentAlignment="Center" Content="{StaticResource ValueX}" FontSize="{StaticResource SettingTitleFontSize}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="4">
                    <Label  Width="{StaticResource BtnTrimmingWidth}"/>
                    <Label  Width="{StaticResource SettingHoleValueWidth}" HorizontalContentAlignment="Center" Content="{StaticResource ValueY}" FontSize="{StaticResource SettingTitleFontSize}" FontWeight="Bold"/>
                </StackPanel>
                <!--安装位置-->
                <Label Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center" Content="{StaticResource InstallPos}" Width="{StaticResource SettingTitleWidth}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label Grid.Row="1" Grid.Column="1" Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <local:ControlSettingPos Grid.Row="1" Grid.Column="2" x:Name="ControlSteelNeedlePosX"/>
                <Label Grid.Row="1" Grid.Column="3" HorizontalContentAlignment="Center" Content="," Width="{StaticResource SettingColonWidth}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <local:ControlSettingPos Grid.Row="1" Grid.Column="4" x:Name="ControlSteelNeedlePosY"/>
            </Grid>

            <!--14#-->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="{StaticResource SettingTitleWidth}" HorizontalContentAlignment="Center" Content="14#" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label  Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource RunTimeSingleHole}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <TextBox x:Name="TextBoxRunTimeSingleHole14" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label Content="{StaticResource UnitSec}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource SpeedAbsorbAndJet}" FontSize="{StaticResource MahApps.Font.Size.Default}" Margin="15,0,0,0" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
                <!--<TextBox x:Name="TextBoxSpeedAbsorbAndJet14" Width="{StaticResource SettingSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>-->
                <ComboBox x:Name="ComboBoxSpeedAbsorbAndJet14" Width="{StaticResource SettingPumpSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}" IsReadOnly="True" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
            </StackPanel>

            <!--15#-->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="{StaticResource SettingTitleWidth}" HorizontalContentAlignment="Center" Content="15#" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label  Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource RunTimeSingleHole}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <TextBox x:Name="TextBoxRunTimeSingleHole15" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label Content="{StaticResource UnitSec}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource SpeedAbsorbAndJet}" FontSize="{StaticResource MahApps.Font.Size.Default}" Margin="15,0,0,0" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
                <!--<TextBox x:Name="TextBoxSpeedAbsorbAndJet15" Width="{StaticResource SettingSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>-->
                <ComboBox x:Name="ComboBoxSpeedAbsorbAndJet15" Width="{StaticResource SettingPumpSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}" IsReadOnly="True" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
            </StackPanel>

            <!--16#-->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="{StaticResource SettingTitleWidth}" HorizontalContentAlignment="Center" Content="16#" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label  Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource RunTimeSingleHole}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <TextBox x:Name="TextBoxRunTimeSingleHole16" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label Content="{StaticResource UnitSec}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource SpeedAbsorbAndJet}" FontSize="{StaticResource MahApps.Font.Size.Default}" Margin="15,0,0,0" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
                <!--<TextBox x:Name="TextBoxSpeedAbsorbAndJet16" Width="{StaticResource SettingSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>-->
                <ComboBox x:Name="ComboBoxSpeedAbsorbAndJet16" Width="{StaticResource SettingPumpSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}" IsReadOnly="True" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
            </StackPanel>

            <!--17#-->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="{StaticResource SettingTitleWidth}" HorizontalContentAlignment="Center" Content="17#" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label  Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource RunTimeSingleHole}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <TextBox x:Name="TextBoxRunTimeSingleHole17" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label Content="{StaticResource UnitSec}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource SpeedAbsorbAndJet}" FontSize="{StaticResource MahApps.Font.Size.Default}" Margin="15,0,0,0" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
                <!--<TextBox x:Name="TextBoxSpeedAbsorbAndJet17" Width="{StaticResource SettingSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>-->
                <ComboBox x:Name="ComboBoxSpeedAbsorbAndJet17" Width="{StaticResource SettingPumpSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}" IsReadOnly="True" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
            </StackPanel>

            <!--18#-->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="{StaticResource SettingTitleWidth}" HorizontalContentAlignment="Center" Content="18#" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label  Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource RunTimeSingleHole}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <TextBox x:Name="TextBoxRunTimeSingleHole18" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label Content="{StaticResource UnitSec}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                <Label HorizontalContentAlignment="Center" Content="{StaticResource SpeedAbsorbAndJet}" FontSize="{StaticResource MahApps.Font.Size.Default}" Margin="15,0,0,0" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
                <!--<TextBox x:Name="TextBoxSpeedAbsorbAndJet18" Width="{StaticResource SettingSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>-->
                <ComboBox x:Name="ComboBoxSpeedAbsorbAndJet18" Width="{StaticResource SettingPumpSpeedWidth}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}" IsReadOnly="True" ToolTip="{StaticResource Prompt_Speed_Level_Hint}"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
