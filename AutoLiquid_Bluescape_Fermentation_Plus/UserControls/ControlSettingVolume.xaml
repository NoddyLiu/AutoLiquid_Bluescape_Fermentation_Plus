<UserControl x:Class="AutoLiquid_Bluescape_Fermentation_Plus.UserControls.ControlSettingVolume"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             Background="White">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal" ToolTip="{StaticResource PercentOfRange}">
                    <Label HorizontalContentAlignment="Center" Content="{StaticResource AbsorbAirBefore}" FontSize="{StaticResource MahApps.Font.Size.Default}" ToolTip="{StaticResource LiquidRangePercent}"/>
                    <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                    <TextBox x:Name="TextBoxAbsorbAirBeforePercent" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}" ToolTip="{StaticResource LiquidRangePercent}"/>
                    <Label Width="{StaticResource SettingUnitWidth}" Content="{StaticResource UnitML}" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" ToolTip="{StaticResource PercentOfRange}" Visibility="Collapsed">
                    <Label HorizontalContentAlignment="Center" Content="{StaticResource AbsorbAirAfter}" FontSize="{StaticResource MahApps.Font.Size.Default}" ToolTip="{StaticResource LiquidRangePercent}"/>
                    <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                    <TextBox x:Name="TextBoxAbsorbAirAfterPercent" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"  ToolTip="{StaticResource LiquidRangePercent}"/>
                    <Label Width="{StaticResource SettingUnitWidth}" Content="%" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                </StackPanel>

                <Separator Style="{StaticResource MahApps.Styles.Separator.StatusBar}" Width="2" Background="LightGray" Margin="0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" ToolTip="{StaticResource PercentOfRange}" Visibility="Collapsed">
                    <Label HorizontalContentAlignment="Center" Content="{StaticResource AbsorbLiquidMore}" FontSize="{StaticResource MahApps.Font.Size.Default}" ToolTip="{StaticResource LiquidRangePercent}"/>
                    <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                    <TextBox x:Name="TextBoxAbsorbLiquidMorePercent" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}"  ToolTip="{StaticResource LiquidRangePercent}"/>
                    <Label Width="{StaticResource SettingUnitWidth}" Content="%" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" ToolTip="{StaticResource PercentOfFormerVolume}" Visibility="Collapsed">
                    <Label HorizontalContentAlignment="Center" Content="{StaticResource JetLiquidMore}" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                    <Label Width="{StaticResource SettingColonWidth}" Content=":" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                    <TextBox x:Name="TextBoxJetLiquidMoreScale" Width="{StaticResource SettingValueWidth}" HorizontalContentAlignment="Center" Text="0" FontSize="{StaticResource MahApps.Font.Size.Default}" />
                    <Label Width="{StaticResource SettingUnitWidth}" Content="%" HorizontalContentAlignment="Center" FontSize="{StaticResource MahApps.Font.Size.Default}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
