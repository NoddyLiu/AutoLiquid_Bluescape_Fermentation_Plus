<UserControl x:Class="AutoLiquid_Bluescape_Fermentation_Plus.UserControls.ControlTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
             mc:Ignorable="d" >
    <Grid>
        <Border BorderBrush="{StaticResource TemplateBorderColor}" BorderThickness="3">
            <Grid x:Name="Template" x:FieldModifier="public">
                <TextBlock x:Name="TextBlockTemplateName" Text="{StaticResource Template1}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource DefaultFontSize}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
