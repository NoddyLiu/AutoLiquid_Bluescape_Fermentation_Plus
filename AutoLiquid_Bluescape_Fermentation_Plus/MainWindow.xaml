<metro:MetroWindow x:Class="AutoLiquid_Bluescape_Fermentation_Plus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus"
        xmlns:metro="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:userControls="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
        xmlns:userControls1="clr-namespace:AutoLiquid_Bluescape_Fermentation_Plus.UserControls"
        mc:Ignorable="d"
        x:Name="mainWindow"
        d:DesignWidth="1920"
        Title="{StaticResource AppName}" WindowState="Maximized"  WindowStartupLocation="CenterScreen" GlowBrush="{DynamicResource MahApps.Brushes.Accent}" TitleCharacterCasing="Normal">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundTemplateCleaning"  Color="LightSeaGreen"/>
        <SolidColorBrush x:Key="BackgroundTemplateSample"  Color="MediumPurple"/>
        <SolidColorBrush x:Key="BackgroundTemplateFermentation"  Color="CornflowerBlue"/>
        <system:Double x:Key="ComboBoxWidth">150</system:Double>
        <system:Double x:Key="LabelIntervalHeight">25</system:Double>
        <system:Double x:Key="StackPanelIntervalWidth">70</system:Double>
        <Thickness x:Key="ComboBoxMargin" Left="0" Top="0" Right="0" Bottom="0" />
    </Window.Resources>

    <Grid>
        <!--内容写在下面-->
        <Grid Margin="10,5,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.25*"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.25*"/>
                </Grid.ColumnDefinitions>
                <!--菜单栏-->
                <Menu x:Name="MenuBar">
                    <MenuItem x:Name="MenuItemUserSetting" Header="{StaticResource Setting}">
                    </MenuItem>
                    <MenuItem x:Name="MenuItemProcedure" Header="{StaticResource Procedure}"/>
                    <MenuItem x:Name="MenuItemPermission" Header="{StaticResource Permission}" Visibility="Collapsed">
                        <MenuItem x:Name="MenuItemModifyPwd" Header="{StaticResource ModifyPwd}"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuItemHelp" Header="{StaticResource Help}">
                        <MenuItem x:Name="MenuItemAbout" Header="{StaticResource About}"/>
                    </MenuItem>
                </Menu>

                <!--温度-->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <!--当前加热温度-->
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                        <Label Content="{StaticResource HeatTemp}" VerticalContentAlignment="Center" Margin="20,0,0,0" Foreground="Red"/>
                        <Label x:Name="LabelCurrentTemp" Content="0.0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,0,0" Width="50" Foreground="Red"/>
                        <Label Content="°C" VerticalContentAlignment="Center" Foreground="Red"/>
                    </StackPanel>

                    <!--留样区制冷温度-->
                    <StackPanel Orientation="Horizontal" Visibility="Hidden">
                        <Label Content="{StaticResource CoolTempSample}" VerticalContentAlignment="Center" Margin="20,0,0,0" Foreground="Green"/>
                        <Label x:Name="LabelCoolTempSample" Content="0.0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,0,0" Width="50" Foreground="Green"/>
                        <Label Content="°C" VerticalContentAlignment="Center" Foreground="Green"/>
                    </StackPanel>
                </StackPanel>

                <!--进度条-->
                <userControls:ControlProgressBar x:Name="ControlProgressBar" Grid.Column="1" Margin="20,0,20,0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16*"/>
                    <ColumnDefinition Width="84*"/>
                </Grid.ColumnDefinitions>

                <!--左侧详细程序链-->
                <Border BorderBrush="{StaticResource TemplateBorderColor}" BorderThickness="3"  Grid.Column="0" Margin="0,0,3,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="50*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,3">
                            <Button x:Name="BtnProcedureChainNew" Content="{StaticResource New}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="50" Height="30" FontSize="14" Margin="5,0,0,0" ToolTip="{StaticResource Prompt_New_Procedure_Chain}"/>
                            <Button x:Name="BtnProcedureChainDel" Content="{StaticResource Delete}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="50" Height="30" FontSize="14" Margin="10,0,0,0" ToolTip="{StaticResource Prompt_Del_Procedure_Chain}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <userControls:ControlDataGridProcedureChain x:Name="ControlDataGridProcedureChain"/>
                            <Grid x:Name="ControlDataGridProcedureChainMask"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,0">
                                <TextBlock Text="{StaticResource ProcedureDetail}" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="：" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextBlockProcedureName" Text="" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource MahApps.Brushes.Accent}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <RichTextBox x:Name="RichTextBoxProcedureDetail"  IsReadOnly="True" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!--盘位分布-->
                <Grid Grid.Column="1" x:Name="GridTemplateContainer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!--清洗区-->
                    <Border BorderBrush="{StaticResource TemplateBorderColor}" Background="{StaticResource BackgroundTemplateCleaning}" BorderThickness="3" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,0,10,10">
                        <Grid>
                            <TextBlock Text="{StaticResource TemplateCleaning}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource DefaultFontSize}"/>
                            <Grid x:Name="TemplateCleaning" />
                        </Grid>
                    </Border>

                    <!--留样区-->
                    <Border BorderBrush="{StaticResource TemplateBorderColor}" Background="{StaticResource BackgroundTemplateSample}" BorderThickness="3" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="5,0,0,0">
                        <Grid>
                            <TextBlock Text="{StaticResource TemplateSample1}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource DefaultFontSize}"/>
                            <Grid x:Name="TemplateSample1" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource TemplateBorderColor}" Background="{StaticResource BackgroundTemplateSample}" BorderThickness="3" Grid.Row="3" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="5,0,0,0">
                        <Grid>
                            <TextBlock Text="{StaticResource TemplateSample2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource DefaultFontSize}"/>
                            <Grid x:Name="TemplateSample2" />
                        </Grid>
                    </Border>

                    <!--发酵区-->
                    <Border BorderBrush="{StaticResource TemplateBorderColor}" Background="{StaticResource BackgroundTemplateFermentation}" BorderThickness="3" Grid.Row="0" Grid.RowSpan="5" Grid.Column="2" Grid.ColumnSpan="9">
                        <Grid>
                            <TextBlock Text="{StaticResource TemplateFermentation1}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource DefaultFontSize}"/>
                            <Grid x:Name="TemplateFermentation1" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource TemplateBorderColor}" Background="{StaticResource BackgroundTemplateFermentation}" BorderThickness="3" Grid.Row="0" Grid.RowSpan="5" Grid.Column="11" Grid.ColumnSpan="9">
                        <Grid>
                            <TextBlock Text="{StaticResource TemplateFermentation2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource DefaultFontSize}"/>
                            <Grid x:Name="TemplateFermentation2" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel  x:Name="BottomBar" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">
                <Button x:Name="BtnFan" Content="{StaticResource FanOpen}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="70" Height="40" FontSize="20" Margin="10,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="BtnShake1" Content="{StaticResource Shake1Open}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="80" Height="40" FontSize="20" Margin="10,0,0,0"/>
                <Button x:Name="BtnShake2" Content="{StaticResource Shake2Open}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="80" Height="40" FontSize="20" Margin="5,0,0,0"/>
                <Button x:Name="BtnInstallSteelNeedle" Content="{StaticResource InstallSteelNeedle}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="90" Height="40" FontSize="20" Margin="10,0,0,0"/>
                <Button x:Name="BtnUV" Content="{StaticResource UVOpen}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="90" Height="40" FontSize="20" Margin="10,0,0,0"/>
                <Button x:Name="BtnCool" Content="{StaticResource CoolOpen}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="70" Height="40" FontSize="20" Margin="10,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="BtnImportData" Content="{StaticResource Import}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="70" Height="40" FontSize="20" Margin="10,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="BtnReset" Content="{StaticResource Reset}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="70" Height="40" FontSize="20" Margin="40,0,0,0"/>
                <Button x:Name="BtnDemo"  Content="{StaticResource Demo}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="70" Height="40" FontSize="20" Margin="10,0,0,0" ToolTip="{StaticResource Prompt_Demo_Mode}"/>
                <Button x:Name="BtnRun"  Content="{StaticResource Run}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="70" Height="40" FontSize="20" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!--运行弹出框-->
        <DockPanel x:Name="LayoutRunningLoading" Width="300" Background="Transparent" VerticalAlignment="Center" Visibility="Hidden">
            <DockPanel.RenderTransform>
                <TranslateTransform x:Name="LayoutLoadingRenderTransform"/>
            </DockPanel.RenderTransform>
            <Border CornerRadius="10" Background="White" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="5">
                <StackPanel VerticalAlignment="Top">
                    <StackPanel  Margin="0,30">
                        <metro:ProgressRing x:Name="ProgressRingLoading" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Label x:Name="LabelPrompt" Content="{StaticResource Prompt_Running_Pls_Wait}" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel x:Name="StackPanelIntervalRemain" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,-20" Visibility="Collapsed">
                        <Label Content="{StaticResource IntervalRemain}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Label x:Name="LabelIntervalRemain" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Red" FontWeight="Bold"/>
                            <Label Content="{StaticResource UnitSec}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <DockPanel x:Name="DockPanelAllBtn" Margin="10,30,15,10">
                        <Button DockPanel.Dock="Right" x:Name="BtnPause" Content="{StaticResource Pause}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="60"/>
                        <StackPanel x:Name="StackPanelStopOrContinue" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnStop"  Content="{StaticResource Stop}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="60" Margin="5,0,0,0"/>
                            <Button x:Name="BtnContinue"  Content="{StaticResource Continue}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Width="60" Margin="5,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DockPanel>

        <!--导入中弹出框-->
        <DockPanel x:Name="LayoutImportLoading" Width="330" Background="Transparent" VerticalAlignment="Center" Visibility="Collapsed">
            <Border CornerRadius="10" Background="White" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="5">
                <StackPanel VerticalAlignment="Top" Margin="0,30">
                    <metro:ProgressRing Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                    <Label Content="{StaticResource Prompt_Importing_Pls_Wait}" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</metro:MetroWindow>
